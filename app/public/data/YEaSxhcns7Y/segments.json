      "words": [{"word": "and", "start": 225.38, "end": 225.74}, {"word": "F", "start": 225.74, "end": 226.18}, {"word": "where", "start": 226.18, "end": 226.62}, {"word": "Latin", "start": 226.62, "end": 226.92}, {"word": "has", "start": 226.92, "end": 227.28}, {"word": "P", "start": 227.28, "end": 227.6}, {"word": "at", "start": 227.6, "end": 228.1}, {"word": "the", "start": 228.1, "end": 228.22}, {"word": "start", "start": 228.22, "end": 228.46}, {"word": "of", "start": 228.46, "end": 228.6}, {"word": "words.", "start": 228.6, "end": 228.96}]
