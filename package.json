{
  "name": "stdylang",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm dev:en\" \"pnpm dev:zh\" \"pnpm dev:ja\" \"node dev-proxy.mjs\"",
    "dev:en": "pnpm --filter @stdylang/english dev",
    "dev:zh": "pnpm --filter @stdylang/chinese dev",
    "dev:ja": "pnpm --filter @stdylang/japanese dev",
    "build:en": "pnpm --filter @stdylang/english build",
    "build:zh": "pnpm --filter @stdylang/chinese build",
    "build:ja": "pnpm --filter @stdylang/japanese build",
    "build:all": "pnpm -r build"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "http-proxy": "^1.18.1"
  }
}
