        { "word": "で", "reading": "で", "meaning": "~이며" },
        { "word": "出てきました", "reading": "でてきました", "meaning": "나타났습니다, 등장했습니다" }
      ]
    },
    {
      "index": 35,
      "start": 255.94,
      "end": 261.20,
      "textJa": "4アルバムを出てきました。 そして、彼はL. A.やSan Diegoで演奏しています。",
      "reading": "4アルバムをでてきました。 そして、かれはL. A.やSan Diegoでえんそうしています。",
      "textKo": "4장의 앨범을 발표했습니다. 그리고 그는 LA나 샌디에이고에서 공연하고 있습니다.",
      "words": [
        { "word": "4アルバム", "reading": "4アルバム", "meaning": "4장의 앨범" },
        { "word": "を", "reading": "を", "meaning": "~을/를" },
        { "word": "出てきました", "reading": "でてきました", "meaning": "내놓았습니다, 발표했습니다" },
