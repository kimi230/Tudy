    },
    {
      "index": 38,
      "start": 275.20,
      "end": 277.90,
      "textJa": "Mousie Saya",
      "reading": "Mousie Saya",
      "textKo": "무시 사야 (인터뷰이 이름)",
      "words": []
    },
    {
      "index": 39,
      "start": 278.56,
      "end": 280.86,
      "textJa": "Maiko Uera",
      "reading": "Maiko Uera",
      "textKo": "마이코 우에라 (인터뷰이 이름)",
      "words": []
    },
    {
      "index": 40,
      "start": 282.80,
      "end": 286.04,
      "textJa": "どんな女性が、このような人々は、このような人々は?",
      "reading": "どんなじょせいが、このようなひとびとは、このようなひとびとは?",
      "textKo": "어떤 여성이, 이런 사람들은, 이런 사람들은?",
      "words": [
        { "word": "どんな", "reading": "どんな", "meaning": "어떤" },
        { "word": "女性", "reading": "じょせい", "meaning": "여성" },
        { "word": "が", "reading": "が", "meaning": "~이/가" },
        { "word": "このような", "reading": "このような", "meaning": "이러한" },
        { "word": "人々", "reading": "ひとびと", "meaning": "사람들" },
        { "word": "は", "reading": "は", "meaning": "~은/는" }
      ]
    },
    {
      "index": 41,
      "start": 286.80,
      "end": 289.80,
      "textJa": "誰? 誰? 僕。",
      "reading": "だれ? だれ? ぼく。",
      "textKo": "누구? 누구? 나.",
      "words": [
        { "word": "誰", "reading": "だれ", "meaning": "누구" },
        { "word": "僕", "reading": "ぼく", "meaning": "나 (남성 1인칭)" }
      ]
    },
    {
      "index": 42,
      "start": 291.58,
      "end": 296.10,
      "textJa": "日本のチカノの文化の未来は、どんな人々は?",
      "reading": "にほんのチカノのぶんかのみらいは、どんなひとびとは?",
      "textKo": "일본 치카노 문화의 미래는, 어떤 사람들인가요?",
      "words": [
        { "word": "日本の", "reading": "にほんの", "meaning": "일본의" },
        { "word": "チカノ", "reading": "チカノ", "meaning": "치카노" },
        { "word": "の", "reading": "の", "meaning": "~의" },
        { "word": "文化", "reading": "ぶんか", "meaning": "문화" },
        { "word": "の", "reading": "の", "meaning": "~의" },
        { "word": "未来", "reading": "みらい", "meaning": "미래" },
        { "word": "は", "reading": "は", "meaning": "~은/는" },
        { "word": "どんな", "reading": "どんな", "meaning": "어떤" },
        { "word": "人々", "reading": "ひとびと", "meaning": "사람들" }
      ]
    },
    {
      "index": 43,
      "start": 299.80,
      "end": 304.32,
      "textJa": "私は正直なところ、亡くなると思う。",
      "reading": "わたしはしょうじきなところ、なくなるとおもう。",
      "textKo": "솔직히 말하면, 사라질 것 같아요.",
      "words": [
        { "word": "私は", "reading": "わたしは", "meaning": "저는" },
        { "word": "正直なところ", "reading": "しょうじきなところ", "meaning": "솔직히 말하면" },
        { "word": "亡くなる", "reading": "なくなる", "meaning": "사라지다, 없어지다" },
        { "word": "と思う", "reading": "とおもう", "meaning": "~라고 생각한다" }
      ]
    },
    {
      "index": 44,
      "start": 304.44,
      "end": 310.78,
      "textJa": "私のきっかけで、チカノという人たちがいるんやって知った若い世代の子は多くて、",
      "reading": "わたしのきっかけで、チカノというひとたちがいるんやってしったわかいせだいのこはおおくて、",
      "textKo": "제 계기로 치카노라는 사람들이 있다는 걸 알게 된 젊은 세대 아이들은 많아서,",
      "words": [
        { "word": "私の", "reading": "わたしの", "meaning": "나의, 제" },
        { "word": "きっかけで", "reading": "きっかけで", "meaning": "계기로" },
        { "word": "チカノ", "reading": "チカノ", "meaning": "치카노" },
        { "word": "という", "reading": "という", "meaning": "~라고 하는" },
        { "word": "人たち", "reading": "ひとたち", "meaning": "사람들" },
        { "word": "がいる", "reading": "がいる", "meaning": "이 있다" },
        { "word": "んやって", "reading": "んやって", "meaning": "~라는 걸 (간사이 방언)" },
        { "word": "知った", "reading": "しった", "meaning": "알게 된" },
        { "word": "若い世代", "reading": "わかいせだい", "meaning": "젊은 세대" },
        { "word": "の子", "reading": "のこ", "meaning": "아이, 젊은이" },
        { "word": "は多くて", "reading": "はおおくて", "meaning": "은 많아서" }
      ]
    },
    {
      "index": 45,
      "start": 311.18,
      "end": 323.46,
      "textJa": "でもその子たちは、私を真似して知ったわけで、本当のチカノたちのライフスタイルを、本当に好きな子っていうのは、本当に数えられる数名しかいないです。日本では。",
      "reading": "でもそのこたちは、わたしをまねしてしったわけで、ほんとうのチカノたちのライフスタイルを、ほんとうにすきなこっていうのは、ほんとうにかぞえられるすうめいしかいないです。にほんでは。",
      "textKo": "하지만 그 아이들은 저를 따라서 알게 된 것이고, 진짜 치카노들의 라이프스타일을 진심으로 좋아하는 아이는 정말 손꼽을 수 있을 만큼 몇 명밖에 없어요. 일본에서는.",
      "words": [
