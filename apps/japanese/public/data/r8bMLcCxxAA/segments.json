        { "word": "が", "reading": "が", "meaning": "~이/가" },
        { "word": "あったんですよ", "reading": "あったんですよ", "meaning": "있었어요" },
        { "word": "彼女同士の", "reading": "かのじょどうしの", "meaning": "여자들끼리의" },
