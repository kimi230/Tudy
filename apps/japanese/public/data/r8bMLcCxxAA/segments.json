        { "word": "最も", "reading": "もっとも", "meaning": "가장, 제일" },
        { "word": "popular", "reading": "ポピュラー", "meaning": "인기 있는" },
        { "word": "Chican-style", "reading": "チカン・スタイル", "meaning": "치카노 스타일" },
