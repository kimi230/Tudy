        { "word": "で", "reading": "で", "meaning": "~에서" },
        { "word": "演奏しています", "reading": "えんそうしています", "meaning": "공연하고 있습니다" }
      ]
    },
    {
      "index": 36,
      "start": 263.02,
      "end": 270.20,
      "textJa": "私は、そのカルチャーを知った時、周りの友達も同じように、そういうカルチャーが好きで、",
      "reading": "わたしは、そのカルチャーをしったとき、まわりのともだちもおなじように、そういうカルチャーがすきで、",
      "textKo": "저는 그 문화를 알게 되었을 때, 주변 친구들도 마찬가지로 그런 문화를 좋아해서,",
      "words": [
        { "word": "私は", "reading": "わたしは", "meaning": "저는" },
        { "word": "その", "reading": "その", "meaning": "그" },
        { "word": "カルチャー", "reading": "カルチャー", "meaning": "문화 (culture)" },
        { "word": "を", "reading": "を", "meaning": "~을/를" },
        { "word": "知った", "reading": "しった", "meaning": "알게 되었다" },
        { "word": "時", "reading": "とき", "meaning": "때, 시간" },
        { "word": "周りの", "reading": "まわりの", "meaning": "주변의" },
        { "word": "友達", "reading": "ともだち", "meaning": "친구" },
        { "word": "も", "reading": "も", "meaning": "~도" },
        { "word": "同じように", "reading": "おなじように", "meaning": "마찬가지로" },
        { "word": "そういう", "reading": "そういう", "meaning": "그런" },
        { "word": "カルチャーが好きで", "reading": "カルチャーがすきで", "meaning": "문화를 좋아해서" }
      ]
    },
    {
      "index": 37,
      "start": 270.56,
      "end": 273.54,
      "textJa": "グループがあったんですよ。 彼女同士の友達。",
      "reading": "グループがあったんですよ。 かのじょどうしのともだち。",
      "textKo": "그룹이 있었어요. 그녀들끼리의 친구들.",
      "words": [
