        { "word": "知った", "reading": "しった", "meaning": "알게 된" },
        { "word": "わけで", "reading": "わけで", "meaning": "~인 것이고" },
        { "word": "本当の", "reading": "ほんとうの", "meaning": "진짜의" },
        { "word": "チカノたちの", "reading": "チカノたちの", "meaning": "치카노들의" },
        { "word": "ライフスタイル", "reading": "ライフスタイル", "meaning": "라이프스타일" },
        { "word": "を", "reading": "を", "meaning": "~을/를" },
        { "word": "本当に好きな", "reading": "ほんとうにすきな", "meaning": "진심으로 좋아하는" },
        { "word": "子っていうのは", "reading": "こっていうのは", "meaning": "아이라는 것은" },
